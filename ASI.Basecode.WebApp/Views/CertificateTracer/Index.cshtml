@{
    ViewData["Title"] = "Certificate PDF tracer";
}

<section class="page-header">
    <h1>Certificate PDF tracer</h1>
    <p>Development only. This fixed sample is not an official certificate and is deleted after download.</p>
</section>

<form asp-controller="CertificateTracer" asp-action="Trace" method="post" class="form-card">
    <div class="form-group">
        <label for="registrationId">Confirmed registration ID</label>
        <input id="registrationId" name="registrationId" type="number" min="1" required />
    </div>
    <button type="submit" class="button button-primary">Render sample PDF</button>
</form>
