@model IPagedResult
@{
    var noun = ListPagingLabels.Noun(ViewContext.RouteData.Values["controller"]?.ToString(), ViewContext.RouteData.Values["action"]?.ToString(), 0, ViewData["ResultNoun"] as string);
}

@if (Model.TotalCount == 0 && ViewData["ListError"] == null && ViewData["LedgerError"] == null)
{
    <p class="muted result-count">0 @(ListPagingLabels.IsFiltered(Context.Request) ? "matching " : "")@noun.</p>
}
