@model EventCoverViewModel
@{
    ViewData["Title"] = "Event Cover";
}

<div class="page-heading">
    <h2>Event cover</h2>
    <a asp-action="Index" class="button button-secondary">Back to events</a>
</div>

<h3>@Model.Title</h3>
<p class="muted">Status: @Model.StatusLabel</p>

@if (Model.HasCover)
{
    <figure>
        <img src="@Url.Action("Image", "EventCover", new { id = Model.EventId })" alt="Cover for @Model.Title" style="max-width: 100%; max-height: 24rem; object-fit: contain;" />
    </figure>
}
else
{
    <p class="empty-state">No cover image has been uploaded.</p>
}

@if (Model.CanUpload)
{
    <form asp-action="UploadCover" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <div class="field">
            <label for="cover" class="field-label">@(Model.HasCover ? "Replace cover image" : "Upload cover image")</label>
            <input id="cover" name="cover" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" class="field-control" />
            <p class="muted">JPEG or PNG, maximum 2 MiB.</p>
        </div>
        <button type="submit" class="button button-primary">@(Model.HasCover ? "Replace cover" : "Upload cover")</button>
    </form>
}
else
{
    <p class="muted">Completed and cancelled event covers are read-only.</p>
}

@if (Model.CanRemove)
{
    <form asp-action="RemoveCover" asp-route-id="@Model.EventId" method="post">
        <button type="submit" class="button button-secondary">Remove draft cover</button>
    </form>
}
