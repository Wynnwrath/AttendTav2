@model ASI.Basecode.Services.ServiceModels.EventTypeViewModel

<div class="card-hairline__body space-y-5 p-6">
    <div asp-validation-summary="ModelOnly" class="text-status-rose text-sm font-medium"></div>

    <input type="hidden" asp-for="TypeId" />

    <div class="field">
        <label asp-for="TypeName" class="field-label field-required">Type Name</label>
        <input asp-for="TypeName" class="input" placeholder="e.g. Seminar, Workshop, Assembly, Outreach" autocomplete="off" required />
        <span asp-validation-for="TypeName" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="Description" class="field-label">Description</label>
        <textarea asp-for="Description" rows="3" class="input" placeholder="Brief summary of event category and purpose..."></textarea>
        <span asp-validation-for="Description" class="text-xs text-status-rose font-medium"></span>
    </div>
</div>
