@model ParticipationReportViewModel
@using System.Globalization
@using ASI.Basecode.Data.Models.Lookups
@{
    ViewData["ListControls"] = true;
    ViewData["Title"] = "Participation report";
    var cancelled = Model.EventStatusId == EventStatusCode.Cancelled;
    var statusCounts = new (RegistrationStatusCode Status, int Count)[]
    {
        (RegistrationStatusCode.Pending, Model.PendingCount),
        (RegistrationStatusCode.Confirmed, Model.ConfirmedCount),
        (RegistrationStatusCode.Waitlisted, Model.WaitlistedCount),
        (RegistrationStatusCode.Cancelled, Model.CancelledCount)
    };
}

<div class="page-heading">
    <div>
        <h1>Participation &amp; Attendance Report</h1>
        <p class="muted">Per-event participation summary and breakdowns.</p>
    </div>
</div>

<partial name="_EventSelector" model="Model.Selector" />
<partial name="_ListToolbar" model='@(new ListToolbarViewModel("Search member or student number", new ListFilterField[] { new ListFilterField("type", "Attendance", Options: new[] { new ListFilterOption("attended", "Attended"), new ListFilterOption("not-attended", "Not attended") }) }))' />
<p class="muted" data-list-status role="status" data-list-busy-label="Loading records…"></p>
@if (Model.EventId is null)
{
    <section class="empty-panel" aria-live="polite">
        @if (Model.Selector.HasOptions)
        {
            <p>Choose Show to load the selected event&rsquo;s participation report.</p>
        }
        else
        {
            <p>No participation data is available yet.</p>
        }
    </section>
}
else
{
    <section class="section-head" aria-labelledby="report-event-heading">
        <div>
            <h2 id="report-event-heading">@Model.EventTitle</h2>
            @if (Model.StartsAt is not null)
            {
                <p class="muted">Starts @ManilaTimeFormatter.Format(Model.StartsAt)</p>
            }
        </div>
        <span class="badge @Model.EventStatusBadgeClass">@Model.EventStatusLabel</span>
    </section>

    <section class="report-summary" aria-label="Report summary">
        <article class="panel">
            <h2>Confirmed</h2>
            <p class="numeric report-value">@Model.ConfirmedCount</p>
        </article>
        <article class="panel">
            <h2>Valid attendees</h2>
            <p class="numeric report-value">@Model.ValidAttendeeCount</p>
        </article>
        <article class="panel">
            <h2>Attendance rate</h2>
            @if (Model.AttendanceRate is null || cancelled)
            {
                <p class="numeric report-value">N/A</p>
            }
            else if (!Model.IsFinal)
            {
                <p class="report-value report-not-final">Not final</p>
                <p class="field-hint">Final once the event is completed.</p>
            }
            else
            {
                <p class="numeric report-value">@((Model.AttendanceRate.Value * 100).ToString("0.#", CultureInfo.InvariantCulture))%</p>
            }
        </article>
        <article class="panel">
            <h2>No-shows</h2>
            @if (cancelled)
            {
                <p class="report-value">—</p>
            }
            else if (!Model.IsFinal)
            {
                <p class="report-value report-not-final">Not final</p>
                <p class="field-hint">Final once the event is completed.</p>
            }
            else
            {
                <p class="numeric report-value">@Model.NoShowCount</p>
            }
        </article>
    </section>

    <section class="report-status-counts" aria-label="Registration status counts">
        @foreach (var item in statusCounts)
        {
            <div class="report-status-count">
                <span class="badge @RegistrationStatusDisplay.BadgeClass(item.Status, false)">@RegistrationStatusDisplay.Label(item.Status, false)</span>
                <span class="numeric">@item.Count</span>
            </div>
        }
    </section>

    <section class="panel" aria-labelledby="report-detail-heading">
        <h2 id="report-detail-heading">Participants</h2>
        @if (Model.Rows.Count == 0)
        {
            <p class="empty-state">No matching participants. Adjust the search or filters to see other records.</p>
        }
        else
        {
            <div class="table-scroll" role="region" aria-label="Participant details" tabindex="0" data-list-region>
                <table class="data-table table-sticky-first">
                    <thead>
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Course / year</th>
                            <th scope="col">Status</th>
                            <th scope="col">Attendance</th><th scope="col" class="actions actions-tight">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr data-registration-id="@row.RegistrationId">
                                <td data-label="Member">@row.MemberName<small class="cell-meta">@row.StudentNumber</small></td>
                                <td data-label="Course / year">@row.Course · Year @row.YearLevel</td>
                                <td data-label="Status"><span class="badge @row.StatusBadgeClass">@row.StatusLabel</span></td>
                                <td data-label="Attendance">
                                    @if (string.IsNullOrEmpty(row.AttendanceBadgeClass))
                                    {
                                        <span class="muted">@row.AttendanceLabel</span>
                                    }
                                    else
                                    {
                                        <span class="badge @row.AttendanceBadgeClass">@row.AttendanceLabel</span>
                                    }
                                </td>
                            <td data-label="Actions" class="actions"><div class="row-actions"><partial name="_DetailsButton" model='@(new RecordDetailsViewModel($"report-details-{row.RegistrationId}", row.MemberName, new Dictionary<string, string> { ["Student number"] = row.StudentNumber, ["Course"] = row.Course, ["Year"] = row.YearLevel.ToString(), ["Attendance"] = row.AttendanceLabel, ["Check-in time"] = row.CheckedInAt is null ? "Not recorded" : ManilaTimeFormatter.Format(row.CheckedInAt.Value) }, null))' /></div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_Pager" model="Model" />

        }
        <partial name="_ResultCount" model="Model" />
    </section>

    <section class="report-breakdowns" aria-label="Attendee breakdowns">
        <article class="panel">
            <h2>By course</h2>
            @if (Model.CourseBreakdown.Count == 0)
            {
                <p class="empty-state">No attendee data is available for this event.</p>
            }
            else
            {
                <ul class="report-breakdown">
                    @foreach (var item in Model.CourseBreakdown)
                    {
                        <li>
                            <span class="report-breakdown-label">@item.Label</span>
                            <span class="report-breakdown-value numeric">@item.Count</span>
                            <span class="report-breakdown-bar" aria-hidden="true">
                                <span style="width: @(item.Percent.ToString(CultureInfo.InvariantCulture))%"></span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </article>
        <article class="panel">
            <h2>By year level</h2>
            @if (Model.YearBreakdown.Count == 0)
            {
                <p class="empty-state">No attendee data is available for this event.</p>
            }
            else
            {
                <ul class="report-breakdown">
                    @foreach (var item in Model.YearBreakdown)
                    {
                        <li>
                            <span class="report-breakdown-label">@item.Label</span>
                            <span class="report-breakdown-value numeric">@item.Count</span>
                            <span class="report-breakdown-bar" aria-hidden="true">
                                <span style="width: @(item.Percent.ToString(CultureInfo.InvariantCulture))%"></span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>
}
