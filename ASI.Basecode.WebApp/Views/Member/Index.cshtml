@model List<ASI.Basecode.Services.ServiceModels.MemberViewModel>
@{
    ViewData["Title"] = "Members";
    Func<string, string> getInitials = (name) =>
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    };

    var activeCount = Model.Count(m => string.Equals(m.Status, "active", StringComparison.OrdinalIgnoreCase));
    var inactiveCount = Model.Count(m => !string.Equals(m.Status, "active", StringComparison.OrdinalIgnoreCase));
    var totalCount = Model.Count;
}

<div class="mx-auto w-full max-w-6xl space-y-6">
    <!-- Page header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
            <h1 class="font-gate text-2xl font-bold tracking-tight text-ink">Members</h1>
            <p class="mt-1 max-w-2xl text-sm text-ink-muted">Provisioned organization members &mdash; student directory of record.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <form asp-action="Index" method="get" class="relative w-full sm:w-72">
                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-ink-muted">
                    <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-search"></use></svg>
                </span>
                <input class="input pl-9" id="member-search" name="search" type="search" value="@ViewBag.Search" autocomplete="off"
                       placeholder="Search name or student number..." />
            </form>
            <div class="flex items-center gap-2" role="group" aria-label="Filter status count">
                <span class="chip">Total <span class="chip__count">@totalCount</span></span>
                <span class="chip">Active <span class="chip__count">@activeCount</span></span>
                <span class="chip">Inactive <span class="chip__count">@inactiveCount</span></span>
            </div>
            <a asp-action="Create" class="btn btn--primary btn--sm inline-flex items-center gap-1.5">
                <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-plus"></use></svg>
                <span>Add Member</span>
            </a>
        </div>
    </div>

    <!-- Members ledger table -->
    <section class="card-hairline" aria-label="Member directory">
        <div class="table-scroll">
            <table class="table-ledger table-ledger--cards" data-table>
                <thead>
                    <tr>
                        <th scope="col" data-sort="name">Member</th>
                        <th scope="col" data-sort="program">Program</th>
                        <th scope="col">Year &amp; Section</th>
                        <th scope="col">Contact</th>
                        <th scope="col">Membership Type</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody data-members-body>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-8 text-ink-muted">
                                No members found matching the criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var member in Model)
                        {
                            var isActive = string.Equals(member.Status, "active", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td data-th="Member">
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-8 w-8 flex-none items-center justify-center rounded-pill bg-ink text-xs font-semibold text-ink-inverse"
                                             aria-hidden="true">
                                            @getInitials(member.FullName)
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-semibold text-ink">@member.FullName</div>
                                            <div class="font-mono text-xs text-ink-muted">@member.StudentNumber</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-th="Program"><span class="font-medium text-ink-secondary">@member.CourseYear</span></td>
                                <td data-th="Year &amp; Section"><span class="font-mono text-xs text-ink-secondary">@member.Section</span></td>
                                <td data-th="Contact"><span class="text-ink-secondary text-xs">@(string.IsNullOrEmpty(member.ContactDetails) ? "—" : member.ContactDetails)</span></td>
                                <td data-th="Membership Type"><span class="font-medium text-xs text-ink">@(string.IsNullOrEmpty(member.MembershipType) ? "Regular" : member.MembershipType)</span></td>
                                <td data-th="Status">
                                    <span class="status-pill" data-status="@(isActive ? "active" : "inactive")">
                                        @(isActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td data-th="Actions" class="text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn--secondary btn--sm" title="Edit member profile">
                                            Edit
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@member.MemberId" method="post" class="inline">
                                            <button type="submit" class="btn btn--ghost btn--sm" title="@(isActive ? "Deactivate member" : "Activate member")">
                                                @(isActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
