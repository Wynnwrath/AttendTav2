@model ASI.Basecode.WebApp.Rendering.CertificateTemplateViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AttendTa Certificate</title>
    <style>
        @@font-face {
            font-family: "Cinzel";
            font-style: normal;
            font-weight: 400;
            src: url("@Html.Raw(Model.CinzelRegularDataUri)") format("truetype");
        }

        @@font-face {
            font-family: "Cinzel";
            font-style: normal;
            font-weight: 600;
            src: url("@Html.Raw(Model.CinzelSemiboldDataUri)") format("truetype");
        }

        @@page {
            size: A4 landscape;
            margin: 0;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 297mm;
            height: 210mm;
            margin: 0;
            padding: 0;
        }

        body {
            color: #142335;
            background: #fbfaf5;
            font-family: "Cinzel", Georgia, serif;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        .sheet {
            position: relative;
            width: 297mm;
            height: 210mm;
            overflow: hidden;
            background: #fbfaf5;
            padding: 16mm 24mm 19mm;
        }

        .outer-rule,
        .inner-rule {
            position: absolute;
            pointer-events: none;
        }

        .outer-rule {
            inset: 8mm;
            border: 1.1mm solid #b18a39;
        }

        .inner-rule {
            inset: 10.5mm;
            border: .35mm solid #d5bc80;
        }

        .content {
            position: relative;
            z-index: 1;
            display: flex;
            height: 100%;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .identity {
            display: flex;
            min-height: 22mm;
            align-items: center;
            justify-content: center;
            gap: 5mm;
        }

        .logo {
            width: 19mm;
            height: 19mm;
            object-fit: contain;
        }

        .institution {
            margin: 0;
            color: #263a50;
            font-size: 12pt;
            font-weight: 600;
            letter-spacing: .17em;
            line-height: 1.35;
            text-transform: uppercase;
        }

        .council {
            margin: 1.4mm 0 0;
            color: #64748b;
            font-family: Arial, sans-serif;
            font-size: 8pt;
            letter-spacing: .2em;
            line-height: 1.4;
            text-transform: uppercase;
        }

        .heading {
            margin: 5mm 0 0;
            color: #9a7023;
            font-size: 25pt;
            font-weight: 600;
            letter-spacing: .08em;
            line-height: 1.2;
            text-transform: uppercase;
        }

        .intro {
            margin: 4mm 0 0;
            color: #475569;
            font-family: Arial, sans-serif;
            font-size: 11pt;
            letter-spacing: .035em;
        }

        .recipient {
            display: flex;
            width: 100%;
            min-height: 19mm;
            max-height: 33mm;
            align-items: center;
            justify-content: center;
            margin: 2mm 0 0;
            overflow: hidden;
            color: #122c49;
            font-size: 31pt;
            font-weight: 600;
            line-height: 1.13;
            overflow-wrap: anywhere;
            text-wrap: balance;
        }

        .recipient.compact {
            font-size: 10pt;
            line-height: 1.15;
        }

        .recognition {
            margin: 3mm 0 0;
            color: #475569;
            font-family: Arial, sans-serif;
            font-size: 10pt;
            line-height: 1.45;
        }

        .event-title {
            display: flex;
            width: 100%;
            min-height: 14mm;
            max-height: 27mm;
            align-items: center;
            justify-content: center;
            margin: 1mm 0 0;
            overflow: hidden;
            color: #1c334c;
            font-size: 19pt;
            font-weight: 600;
            line-height: 1.18;
            overflow-wrap: anywhere;
            text-wrap: balance;
        }

        .event-title.compact {
            font-size: 9pt;
            line-height: 1.2;
        }

        .dates {
            display: flex;
            width: 100%;
            justify-content: center;
            gap: 18mm;
            margin-top: 5mm;
            font-family: Arial, sans-serif;
        }

        .date-item {
            min-width: 60mm;
            text-align: center;
        }

        .date-label {
            display: block;
            margin-bottom: 1.5mm;
            color: #8a6b2c;
            font-size: 8pt;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .date-value {
            display: block;
            color: #334155;
            font-size: 9pt;
            line-height: 1.3;
            white-space: nowrap;
        }

        .number {
            position: absolute;
            right: 0;
            bottom: 13mm;
            left: 0;
            z-index: 2;
            color: #64748b;
            font-family: Arial, sans-serif;
            font-size: 8pt;
            letter-spacing: .06em;
            text-align: center;
        }

        .number strong {
            color: #263a50;
            font-family: "Courier New", monospace;
            font-weight: 700;
            letter-spacing: 0;
        }

        .number.long strong {
            display: block;
            max-width: 240mm;
            margin: 1mm auto 0;
            overflow-wrap: anywhere;
            font-size: 7pt;
        }

        .signatory {
            position: absolute;
            right: 29mm;
            bottom: 18mm;
            z-index: 2;
            width: 62mm;
            color: #263a50;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        .signatory-signature {
            display: block;
            width: 100%;
            height: 17mm;
            object-fit: contain;
            object-position: center bottom;
        }

        .signatory-name {
            margin: 0;
            padding-top: 1mm;
            border-top: .25mm solid #64748b;
            font-size: 9pt;
            font-weight: 700;
        }

        .signatory-title {
            margin: 1mm 0 0;
            color: #64748b;
            font-size: 8pt;
        }

        .watermark {
            position: absolute;
            top: 72%;
            left: 50%;
            z-index: 0;
            width: 100%;
            transform: translate(-50%, -50%) rotate(-13deg);
            color: rgba(157, 48, 36, .105);
            font-size: 30pt;
            font-weight: 600;
            letter-spacing: .14em;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
        }

        .development-banner {
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            z-index: 3;
            min-height: 10mm;
            padding: 2.3mm 8mm 2mm;
            background: #9d3024;
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 9pt;
            font-weight: 700;
            letter-spacing: .16em;
            text-align: center;
        }
    </style>
</head>
<body>
    <main class="sheet">
        @if (Model.IsDevelopmentSample)
        {
            <div class="watermark" aria-hidden="true">DEVELOPMENT SAMPLE</div>
        }
        <div class="outer-rule" aria-hidden="true"></div>
        <div class="inner-rule" aria-hidden="true"></div>
        <section class="content" aria-label="Certificate of participation">
            <header class="identity">
                <img class="logo" src="@Model.LogoDataUri" alt="AttendTa logo" />
                <div>
                    <p class="institution">University of Cebu</p>
                    <p class="council">Student Organization Council · AttendTa</p>
                </div>
            </header>
            <h1 class="heading">Certificate of Participation</h1>
            <p class="intro">This certificate is presented to</p>
            <p class="recipient @Model.RecipientSizeClass">@Model.RecipientName</p>
            <p class="recognition">in recognition of participation in</p>
            <p class="event-title @Model.EventSizeClass">@Model.EventTitle</p>
            <div class="dates">
                <div class="date-item">
                    <span class="date-label">Event start · Manila time</span>
                    <span class="date-value">@Model.EventStartsAtManila</span>
                </div>
                <div class="date-item">
                    <span class="date-label">Date issued · Manila time</span>
                    <span class="date-value">@Model.IssuedAtManila</span>
                </div>
            </div>
        </section>
        <div class="number @Model.NumberSizeClass">Certificate number <strong>@Model.CertificateNumber</strong></div>
        @if (Model.IsDevelopmentSample)
        {
            <div class="development-banner">DEVELOPMENT SAMPLE · NOT AN OFFICIAL CERTIFICATE</div>
        }
        else
        {
            <section class="signatory" aria-label="Authorized certificate signatory">
                <img class="signatory-signature" src="@Html.Raw(Model.SignatureDataUri)" alt="Signature of @Model.SignatoryName" />
                <p class="signatory-name">@Model.SignatoryName</p>
                <p class="signatory-title">@Model.SignatoryTitle</p>
            </section>
        }
    </main>
</body>
</html>
