@using Microsoft.AspNetCore.Antiforgery
@using ASI.Basecode.Resources.Constants
@inject IAntiforgery Antiforgery
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var error = TempData["ErrorMessage"] as string;
    var success = TempData["SuccessMessage"] as string;
    var message = !string.IsNullOrWhiteSpace(error) ? error : success;
    var isError = !string.IsNullOrWhiteSpace(error);
    var authenticated = User.Identity?.IsAuthenticated == true;
    var management = authenticated && (User.IsInRole(RoleCodes.Admin) || User.IsInRole(RoleCodes.Officer));
    var shellWidth = authenticated ? null : ViewData["ShellWidth"] as string;
    var shellClass = authenticated ? "authenticated" : "public-shell";
    if (!string.IsNullOrWhiteSpace(shellWidth))
    {
        shellClass += " " + shellWidth;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="RequestVerificationToken" content="@token" />
    <title>@ViewData["Title"] · AttendTa</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="app-shell @shellClass">
        @await Html.PartialAsync("_Header")
        @if (management)
        {
            <div class="management-topbar"><span>@ViewData["Title"]</span><span>@User.Identity?.Name</span></div>
        }
        <main id="main-content" class="main-content" tabindex="-1">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="notice @(isError ? "notice-error" : "notice-success")" role="@(isError ? "alert" : "status")">@message</div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
