@model ASI.Basecode.Services.ServiceModels.MemberViewModel

<div class="card-hairline__body space-y-5 p-6">
    <div asp-validation-summary="ModelOnly" class="text-status-rose text-sm font-medium"></div>

    <input type="hidden" asp-for="MemberId" />

    <div class="field">
        <label asp-for="StudentNumber" class="field-label field-required">Student Number</label>
        <input asp-for="StudentNumber" class="input input--mono" placeholder="e.g. 2023-10482" autocomplete="off" required />
        <span asp-validation-for="StudentNumber" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="FullName" class="field-label field-required">Full Name</label>
        <input asp-for="FullName" class="input" placeholder="e.g. Maria Clara C. Santos" autocomplete="off" required />
        <span asp-validation-for="FullName" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="field">
            <label asp-for="CourseYear" class="field-label field-required">Course &amp; Year</label>
            <input asp-for="CourseYear" class="input" placeholder="e.g. BSIT 3rd Year" autocomplete="off" required />
            <span asp-validation-for="CourseYear" class="text-xs text-status-rose font-medium"></span>
        </div>

        <div class="field">
            <label asp-for="Section" class="field-label field-required">Section</label>
            <input asp-for="Section" class="input input--mono" placeholder="e.g. 3-A" autocomplete="off" required />
            <span asp-validation-for="Section" class="text-xs text-status-rose font-medium"></span>
        </div>
    </div>

    <div class="field">
        <label asp-for="ContactDetails" class="field-label">Contact Details / Email</label>
        <input asp-for="ContactDetails" class="input" placeholder="e.g. maria.santos@ustp.edu.ph or 09171234567" autocomplete="off" />
        <span asp-validation-for="ContactDetails" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="MembershipType" class="field-label">Membership Type</label>
        <input asp-for="MembershipType" class="input" placeholder="e.g. Regular, Officer, Alumni" autocomplete="off" />
        <span asp-validation-for="MembershipType" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="Status" class="field-label">Status</label>
        <select asp-for="Status" class="input">
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <span asp-validation-for="Status" class="text-xs text-status-rose font-medium"></span>
    </div>
</div>
