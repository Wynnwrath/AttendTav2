@model ChangeAccountRoleViewModel
<form asp-action="ChangeRole" asp-route-id="@Model.AccountId" method="post" data-record-form>
    <partial name="_RoleFields" model="Model" />
    <footer class="record-dialog-actions">
        <button type="button" class="button button-secondary" data-record-close>Cancel</button>
        <button type="submit" class="button button-primary">Save role</button>
    </footer>
</form>
