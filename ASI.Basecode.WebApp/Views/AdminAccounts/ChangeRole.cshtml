@model ChangeAccountRoleViewModel
@{ ViewData["Title"] = "Change role"; }
<div class="page-heading"><h1>Change role</h1><a asp-action="Index" class="button button-secondary">Back to accounts</a></div>
<div class="form-panel">
    <form asp-action="ChangeRole" asp-route-id="@Model.AccountId" method="post">
        <partial name="_RoleFields" model="Model" />
        <div class="form-actions">
            <a asp-action="Index" class="button button-secondary">Cancel</a>
            <button type="submit" class="button button-primary">Save role</button>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
