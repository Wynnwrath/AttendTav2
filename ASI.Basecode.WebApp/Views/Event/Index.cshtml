@model PagedResult<EventViewModel>
@using ASI.Basecode.Data.Models.Lookups
@{
    ViewData["ListControls"] = true;
    ViewData["Title"] = "Events";
    ViewData["Feature"] = "record-dialog";
}

<div class="page-heading">
    <h1>Event Management</h1>
    <a asp-action="Create" class="button button-primary" data-record-open="create-event" data-record-title="Create draft event">Create draft event</a>
</div>

@{
    var typeOptions = ViewData["EventTypeFilters"] as IReadOnlyList<EventTypeOption> ?? Array.Empty<EventTypeOption>();
}
<partial name="_ListToolbar" model='@(new ListToolbarViewModel("Search event title", new ListFilterField[] { ListToolbarViewModel.Status(new ListFilterOption("Draft", "Draft"), new ListFilterOption("Published", "Published"), new ListFilterOption("Completed", "Completed"), new ListFilterOption("Cancelled", "Cancelled")), new ListFilterField("typeId", "Event type", Options: typeOptions.Select(item => new ListFilterOption(item.TypeId.ToString(), item.TypeName)).ToArray()) }))' />
<p class="muted" data-list-status role="status" data-list-busy-label="Loading records…"></p>
<div class="table-scroll" role="region" aria-label="Event table" tabindex="0" data-list-region>
    <table class="data-table table-sticky">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Venue</th>
                <th scope="col">Starts</th>
                <th scope="col">Status</th>
                <th scope="col" class="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="empty-state">No records found.</td>
                </tr>
            }
            else
            {
                foreach (var eventItem in Model.Items)
                {
                    var checkInMeta = eventItem.IsCheckInOpen
                        ? (eventItem.CheckInOpenedAt.HasValue && !string.IsNullOrWhiteSpace(eventItem.CheckInOpenedByName)
                            ? $"Opened by {eventItem.CheckInOpenedByName} · {ManilaTimeFormatter.Format(eventItem.CheckInOpenedAt)}"
                            : null)
                        : (eventItem.CheckInClosedAt.HasValue && !string.IsNullOrWhiteSpace(eventItem.CheckInClosedByName)
                            ? $"Closed by {eventItem.CheckInClosedByName} · {ManilaTimeFormatter.Format(eventItem.CheckInClosedAt)}"
                            : null);
                    var details = new RecordDetailsViewModel($"event-details-{eventItem.EventId}", eventItem.Title, new Dictionary<string, string> { ["Venue"] = eventItem.VenueName, ["Event starts"] = ManilaTimeFormatter.Format(eventItem.StartsAt), ["Registration closes"] = ManilaTimeFormatter.Format(eventItem.RegistrationDeadline), ["Participant limit"] = eventItem.ParticipantLimit.ToString(), ["Description"] = eventItem.Description, ["Check-in"] = eventItem.IsCheckInOpen ? "Open" : "Closed" }, null);
                    <tr data-event-id="@eventItem.EventId">
                        <td data-label="Title" class="cell-title"><a asp-action="Details" asp-route-id="@eventItem.EventId">@eventItem.Title</a><small class="cell-meta">@eventItem.TypeName</small></td>
                        <td data-label="Venue">@eventItem.VenueName</td>
                        <td data-label="Starts" class="numeric cell-date">@ManilaTimeFormatter.Format(eventItem.StartsAt)</td>
                        <td data-label="Status"><span class="badge @EventStatusDisplay.BadgeClass(eventItem.EventStatusId)">@eventItem.StatusLabel</span></td>
                        <td data-label="Actions" class="actions">
                            <div class="row-actions">

                                @if (eventItem.EventStatusId == EventStatusCode.Draft)
                                {
                                    <form asp-action="Publish" method="post" class="inline-form">
                                        <input type="hidden" name="id" value="@eventItem.EventId" />
                                        <button type="submit" class="button button-primary">Publish</button>
                                    </form>
                                }
                                else if (eventItem.EventStatusId == EventStatusCode.Published)
                                {
                                    <a asp-action="Details" asp-route-id="@eventItem.EventId" class="button button-secondary">Manage event</a>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@eventItem.EventId" class="button button-secondary">View dossier</a>
                                }
                                <partial name="_RowMenuTrigger" model="@($"row-menu-event-{eventItem.EventId}")" />
                            </div>
                            <div id="row-menu-event-@eventItem.EventId" popover class="row-menu">
                                <partial name="_DetailsTrigger" model="details" />
                                @if (eventItem.EventStatusId == EventStatusCode.Published)
                                {
                                    <form asp-controller="Event" asp-action="@(eventItem.IsCheckInOpen ? "CloseCheckIn" : "OpenCheckIn")" method="post">
                                        <input type="hidden" name="id" value="@eventItem.EventId" />
                                        <button type="submit" class="button">@(eventItem.IsCheckInOpen ? "Close check-in" : "Open check-in")</button>
                                    </form>
                                }
                                <a asp-action="Cover" asp-route-id="@eventItem.EventId">Cover</a>
                                @if (eventItem.EventStatusId is EventStatusCode.Draft or EventStatusCode.Published)
                                {
                                    <a asp-action="Details" asp-route-id="@eventItem.EventId">View dossier</a>
                                    <a asp-action="Edit" asp-route-id="@eventItem.EventId" data-record-open="edit-event-@eventItem.EventId" data-record-title="Edit event" data-record-subtitle="@eventItem.Title">Edit</a>
                                    <div class="row-menu-danger">
                                        <a asp-action="Cancel" asp-route-id="@eventItem.EventId">Cancel</a>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(checkInMeta))
                                {
                                    <p class="row-menu-meta">@checkInMeta</p>
                                }
                            </div>
                        <partial name="_DetailsDialog" model="details" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model" />
<partial name="_ResultCount" model="Model" />
<partial name="_RecordDialog" />
