@using ASI.Basecode.Data.Interfaces
@using ASI.Basecode.Data.Models.Lookups
@model PagedResult<RegistrationReviewRow>
@{
    ViewData["Title"] = "Registration review";
    ViewData["ListControls"] = true;
    var status = ViewBag.Status as string ?? "pending";
    var eventId = ViewBag.EventId as int?;
    var events = ViewData["EventOptions"] as IReadOnlyList<EventSelectorOption> ?? Array.Empty<EventSelectorOption>();
    var reopen = TempData["ReviewDialog"] as string;
    var failedId = Convert.ToInt32(TempData["ReviewId"] ?? 0);
    var reason = TempData["ReviewReason"] as string;
    var failedRow = Model.Items.FirstOrDefault(row => row.RegistrationId == failedId);
    var toolbar = new ListToolbarViewModel("Search participant, student number, or event", new[] {
        new ListFilterField("status", "Status", Options: new[] { new ListFilterOption("pending", "Pending review"), new("confirmed", "Confirmed"), new("waitlisted", "Waitlisted"), new("cancelled", "Cancelled / declined") }, AllowEmpty: false),
        new ListFilterField("eventId", "Event", Options: events.Select(item => new ListFilterOption(item.EventId.ToString(), item.Title)).ToArray())
    });
}
<div class="page-heading"><h1>Registration review</h1></div>
<partial name="_ListToolbar" model="toolbar" />
<p class="muted" data-list-status role="status" data-list-busy-label="Loading records…"></p>
@if (status == "waitlisted" && eventId.HasValue && Model.Items.Count > 0)
{
    <form asp-action="Promote" method="post" class="spacing-bottom"><input type="hidden" name="eventId" value="@eventId" /><input type="hidden" name="page" value="@Model.PageNumber" /><button type="submit" class="button button-secondary">Promote next eligible participant</button></form>
}
@if (failedRow == null && !string.IsNullOrWhiteSpace(reason))
{
    <div class="notice" role="status"><p>The registration is no longer on this page. Your unsaved reason is retained below.</p><p>@reason</p></div>
}
<div class="table-scroll" role="region" aria-label="Registration review" tabindex="0" data-list-region>
    <table class="data-table">
        <thead><tr><th scope="col">Participant</th><th scope="col">Event</th><th scope="col">Status</th><th scope="col" class="actions">Actions</th></tr></thead>
        <tbody>
            @if (Model.Items.Count == 0) { <tr><td colspan="4" class="empty-state">No matching registrations. Adjust the search or filters to see other records.</td></tr> }
            @foreach (var row in Model.Items)
            {
                <tr data-registration-id="@row.RegistrationId">
                    <td data-label="Participant">@row.MemberName<small class="cell-meta">@row.StudentNumber</small></td>
                    <td data-label="Event"><a asp-controller="Event" asp-action="Details" asp-route-id="@row.EventId">@row.EventTitle</a></td>
                    <td data-label="Status"><span class="badge @RegistrationStatusDisplay.BadgeClass(row.Status, false)">@row.Status</span></td>
                    <td data-label="Actions" class="actions"><div class="row-actions">

                        @if (row.Status == RegistrationStatusCode.Pending)
                        {
                            <button type="button" class="button button-secondary button-small" data-dialog-open="approve" data-dialog-value-id="@row.RegistrationId" data-dialog-value-summary="Approve @row.MemberName (@row.StudentNumber) for @row.EventTitle?">Approve</button>
                            <button type="button" class="button button-quiet-danger button-small" data-dialog-open="decline" data-dialog-value-id="@row.RegistrationId" data-dialog-value-summary="Decline @row.MemberName (@row.StudentNumber) for @row.EventTitle?">Decline</button>
                        }
                        else if (row.Status is RegistrationStatusCode.Confirmed or RegistrationStatusCode.Waitlisted)
                        {
                            <button type="button" class="button button-quiet-danger button-small" data-dialog-open="registration-cancel" data-dialog-value-id="@row.RegistrationId" data-dialog-value-summary="Cancel the registration of @row.MemberName (@row.StudentNumber) for @row.EventTitle?">Cancel registration</button>
                        }
                        <partial name="_DetailsButton" model='@(new RecordDetailsViewModel($"registration-details-{row.RegistrationId}", row.MemberName, new Dictionary<string, string> { ["Student number"] = row.StudentNumber, ["Event"] = row.EventTitle, ["Submitted"] = ManilaTimeFormatter.Format(row.SubmittedAt), ["Status"] = row.Status.ToString(), ["Course"] = row.Course, ["Year"] = row.YearLevel.ToString() }))' />
                        </div></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="Model" />
<partial name="_ResultCount" model="Model" />
@foreach (var decision in new[] { (Key: "approve", Title: "Approve registration", Action: "Approve", NeedsReason: false), (Key: "decline", Title: "Decline registration", Action: "Decline", NeedsReason: true), (Key: "registration-cancel", Title: "Cancel registration", Action: "Cancel", NeedsReason: true) })
{
    <dialog id="@decision.Key" class="task-dialog" aria-labelledby="@decision.Key-title" aria-describedby="@decision.Key-summary" data-reopen="@(reopen == decision.Key && failedRow != null ? "true" : null)" data-reopen-id="@failedId" data-reopen-reason="@reason">
        <form asp-action="@decision.Action" method="post">
            <input type="hidden" name="id" data-dialog-field="id" /><input type="hidden" name="status" value="@status" /><input type="hidden" name="eventId" value="@eventId" /><input type="hidden" name="page" value="@Model.PageNumber" />
            <div class="dialog-header"><h2 id="@decision.Key-title">@decision.Title</h2><button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">&times;</button></div>
            <p id="@decision.Key-summary" class="muted" data-dialog-field="summary">@(failedRow == null ? string.Empty : $"{failedRow.MemberName} ({failedRow.StudentNumber}) · {failedRow.EventTitle}")</p>
            @if (decision.NeedsReason)
            {
                <div class="field"><label for="@decision.Key-reason">Reason (required)</label><textarea id="@decision.Key-reason" name="reason" rows="3" maxlength="500" required></textarea><span class="field-hint">Explain this decision. Up to 500 characters.</span></div>
            }
            else { <p class="dialog-consequence">The event's current capacity and registration rules will be checked before this decision is saved.</p> }
            <div class="dialog-actions"><button type="button" class="button button-secondary" data-dialog-close>Back</button><button type="submit" class="button @(decision.NeedsReason ? "button-danger" : "button-primary")" data-submitting-label="Saving…">@decision.Title</button></div>
        </form>
    </dialog>
}
