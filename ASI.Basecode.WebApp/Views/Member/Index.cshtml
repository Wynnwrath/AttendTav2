@model PagedResult<MemberViewModel>
@{
    ViewData["Title"] = "Members";
}

<div class="page-heading">
    <h2>Member Management</h2>
    <span class="muted">Member profiles are linked to approved user accounts.</span>
</div>

<form asp-action="Index" method="get" class="spacing-bottom">
    <div class="search-group">
        <input type="text" name="search" aria-label="Search members" value="@ViewBag.Search" class="field-control" placeholder="Search by name or student number" />
        <button type="submit" class="button button-secondary">Search</button>
    </div>
</form>

<div class="table-scroll" role="region" aria-label="Member table" tabindex="0">
<table class="data-table">
    <thead>
        <tr>
            <th scope="col">Student Number</th>
            <th scope="col">Full Name</th>
            <th scope="col">Course</th>
            <th scope="col">Year</th>
            <th scope="col">Section</th>
            <th scope="col">Mobile</th>
            <th scope="col">Membership Type</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Items)
        {
            <tr data-member-id="@member.MemberId">
                <td>@member.StudentNumber</td>
                <td>@member.FullName</td>
                <td>@member.Course</td>
                <td>@member.YearLevel</td>
                <td>@member.Section</td>
                <td>@member.MobileNumber</td>
                <td>@member.MembershipType</td>
                <td>@member.Status</td>
                <td class="actions">
                    <a asp-action="Edit" asp-route-id="@member.MemberId" class="button button-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@if (Model.Items.Count == 0)
{
    <p class="empty-state">@(string.IsNullOrWhiteSpace(ViewBag.Search as string) ? "No members found." : "No members match your search.")</p>
}
else
{
    <partial name="_Pager" model="Model" />
}
