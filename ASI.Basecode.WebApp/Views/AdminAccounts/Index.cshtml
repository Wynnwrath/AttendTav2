@model PagedResult<AccountSummaryViewModel>
@{
    ViewData["Title"] = "Accounts & Roles";
    var search = ViewBag.Search as string;
}

<div class="page-heading">
    <h2>Accounts &amp; Roles</h2>
    <span class="muted">Review account roles and whether access is active.</span>
</div>

<form asp-action="Index" method="get" class="spacing-bottom">
    <div class="search-group">
        <input type="text" name="search" aria-label="Search accounts" value="@search" class="field-control" placeholder="Search by name or email" />
        <button type="submit" class="button button-secondary">Search</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="empty-state">@(string.IsNullOrWhiteSpace(search) ? "No accounts found." : "No accounts match your search.")</p>
}
else
{
    <div class="table-scroll" role="region" aria-label="Accounts table" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Full Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.Items)
                {
                    <tr data-account-id="@account.AccountId">
                        <td>@account.FullName</td>
                        <td>@account.Email</td>
                        <td><span class="badge badge-@account.RoleCode">@account.RoleLabel</span></td>
                        <td><span class="badge @(account.IsActive ? "badge-active" : "badge-inactive")">@(account.IsActive ? "Active" : "Inactive")</span></td>
                        <td><a asp-action="ChangeRole" asp-route-id="@account.AccountId" class="button button-secondary">Change role</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model" />
}
