@model List<ASI.Basecode.Services.ServiceModels.VenueViewModel>
@{
    ViewData["Title"] = "Venues";
}

<div class="mx-auto w-full max-w-6xl space-y-6">
    <!-- Page header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
            <h1 class="font-gate text-2xl font-bold tracking-tight text-ink">Venues</h1>
            <p class="mt-1 max-w-2xl text-sm text-ink-muted">Registered event locations, capacities, and facility coordinators.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <a asp-action="Create" class="btn btn--primary btn--sm inline-flex items-center gap-1.5">
                <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-plus"></use></svg>
                <span>Add Venue</span>
            </a>
        </div>
    </div>

    <!-- Venues table -->
    <section class="card-hairline" aria-label="Venue directory">
        <div class="table-scroll">
            <table class="table-ledger table-ledger--cards" data-table>
                <thead>
                    <tr>
                        <th scope="col" data-sort="name">Venue</th>
                        <th scope="col" data-sort="building">Building / Location</th>
                        <th scope="col" data-sort="capacity" class="text-right">Capacity</th>
                        <th scope="col">Contact Person</th>
                        <th scope="col">Availability Notes</th>
                        <th scope="col" class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-8 text-ink-muted">
                                No venues registered yet. Click "Add Venue" to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var venue in Model)
                        {
                            <tr>
                                <td data-th="Venue">
                                    <div class="min-w-0">
                                        <div class="font-semibold text-ink">@venue.RoomName</div>
                                        <div class="font-mono text-xs text-ink-muted">venue-@venue.VenueId</div>
                                    </div>
                                </td>
                                <td data-th="Building"><span class="text-ink-secondary">@(string.IsNullOrEmpty(venue.Location) ? "—" : venue.Location)</span></td>
                                <td data-th="Capacity" class="num text-right font-mono font-medium">@venue.Capacity</td>
                                <td data-th="Contact"><span class="text-xs text-ink-secondary">@(string.IsNullOrEmpty(venue.ContactPerson) ? "—" : venue.ContactPerson)</span></td>
                                <td data-th="Notes"><span class="text-xs text-ink-muted">@(string.IsNullOrEmpty(venue.AvailabilityNotes) ? "—" : venue.AvailabilityNotes)</span></td>
                                <td data-th="Actions" class="text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <a asp-action="Edit" asp-route-id="@venue.VenueId" class="btn btn--secondary btn--sm">
                                            Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
