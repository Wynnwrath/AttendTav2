@model ASI.Basecode.Services.ServiceModels.VenueViewModel
@{
    ViewData["Title"] = "Add Venue";
}

<div class="mx-auto w-full max-w-2xl space-y-6">
    <div class="min-w-0">
        <h1 class="font-gate text-2xl font-bold tracking-tight text-ink">New Venue</h1>
        <p class="mt-1 max-w-2xl text-sm text-ink-muted">Register a room or facility used to host organization events.</p>
    </div>

    <form asp-action="Create" method="post" class="card-hairline">
        @Html.Partial("_Form", Model)
        <div class="card-hairline__footer sticky bottom-0 z-sticky flex flex-wrap items-center justify-end gap-2 bg-white p-4 border-t border-slate-200">
            <a asp-action="Index" class="btn btn--ghost">Cancel</a>
            <button type="submit" class="btn btn--primary">Save Venue</button>
        </div>
    </form>
</div>
