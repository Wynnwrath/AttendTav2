@model PagedResult<VenueViewModel>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["ListControls"] = true;
    ViewData["Title"] = "Campus Facilities & Venues";
    ViewData["Feature"] = "record-dialog";
    var statusFilter = ViewBag.Status as string;
    var listError = ViewData["ListError"] as string;
}

<div class="page-heading">
    <h1>Campus Facilities &amp; Venues</h1>
    <a asp-action="Create" class="button button-primary" data-record-open="create-venue" data-record-title="New Venue">New Venue</a>
</div>

<partial name="_ListToolbar" model='@(new ListToolbarViewModel("Search venue or location"))' />
<div class="sheet-keys">
    <nav class="filter-tabs" aria-label="Venue status">
        <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = null })' class="filter-tab" aria-current="@(string.IsNullOrEmpty(statusFilter) ? "page" : null)">All</a>
        <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = "active" })' class="filter-tab" aria-current="@(statusFilter == "active" ? "page" : null)">Active</a>
        <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = "inactive" })' class="filter-tab" aria-current="@(statusFilter == "inactive" ? "page" : null)">Inactive</a>
    </nav>
</div>

<p class="muted" data-list-status role="status" data-list-busy-label="Loading venues…"></p>

@if (!string.IsNullOrEmpty(listError))
{
    <div class="notice notice-error" role="alert">
        <p>@listError</p>
        <a href="@Context.Request.GetEncodedPathAndQuery()">Try again</a>
    </div>
    <div class="table-scroll" role="region" aria-label="Venue table" tabindex="0" data-list-region>
        <table class="data-table table-sticky">
            <thead>
                <tr>
                    <th scope="col">Room Name</th>
                    <th scope="col">Capacity</th>
                    <th scope="col">Location</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="table-scroll" role="region" aria-label="Venue table" tabindex="0" data-list-region>
        <table class="data-table table-sticky">
            <thead>
                <tr>
                    <th scope="col">Room Name</th>
                    <th scope="col">Capacity</th>
                    <th scope="col">Location</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" class="empty-state">
                        @if (string.IsNullOrEmpty(statusFilter))
                        {
                            <text>No venues yet. Use "New Venue" to create the first one.</text>
                        }
                        else
                        {
                            <text>No @statusFilter venues.</text>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-scroll" role="region" aria-label="Venue table" tabindex="0" data-list-region>
        <table class="data-table table-sticky">
            <thead>
                <tr>
                    <th scope="col">Room Name</th>
                    <th scope="col">Capacity</th>
                    <th scope="col">Location</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venue in Model.Items)
                {
                    var details = new RecordDetailsViewModel($"venue-details-{venue.VenueId}", venue.RoomName, new Dictionary<string, string> { ["Location"] = venue.Location, ["Capacity"] = venue.Capacity.ToString(), ["Availability notes"] = venue.AvailabilityNotes, ["Contact person"] = venue.ContactPerson }, Url.Action("Photo", "Venue", new { id = venue.VenueId }));
                    <tr data-venue-id="@venue.VenueId">
                        <td data-label="Room Name" class="cell-name"><span class="cell-strong">@venue.RoomName</span></td>
                        <td data-label="Capacity" class="numeric">@venue.Capacity</td>
                        <td data-label="Location">@venue.Location</td>
                        <td data-label="Status"><span class="badge @(venue.IsActive ? "badge-active" : "badge-inactive")">@(venue.IsActive ? "Active" : "Inactive")</span></td>
                        <td data-label="Actions" class="actions">
                            <div class="row-actions">

                                <a asp-action="Edit" asp-route-id="@venue.VenueId" class="button button-small button-secondary" data-record-open="edit-venue-@venue.VenueId" data-record-title="Edit Venue">Edit</a>
                                <partial name="_RowMenuTrigger" model="@($"row-menu-venue-{venue.VenueId}")" />
                            </div>
                            <div id="row-menu-venue-@venue.VenueId" popover class="row-menu">
                                <partial name="_DetailsTrigger" model="details" />
                                <form asp-action="ToggleActive" asp-route-id="@venue.VenueId" method="post">
                                    <input type="hidden" name="page" value="@Model.PageNumber" />
                                    <div class="@(venue.IsActive ? "row-menu-danger" : null)">
                                        <button type="submit" class="button" data-submitting-label="@(venue.IsActive ? "Deactivating…" : "Activating…")">@(venue.IsActive ? "Deactivate" : "Activate")</button>
                                    </div>
                                </form>
                            </div>
                        <partial name="_DetailsDialog" model="details" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model" />
}

<partial name="_ResultCount" model="Model" />
<partial name="_RecordDialog" />
