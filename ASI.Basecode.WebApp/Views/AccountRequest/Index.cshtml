@model AccountRequestQueueViewModel
@using System
@using System.Linq
@{
    ViewData["ListControls"] = true;
    ViewData["Title"] = "Account requests";
    ViewData["ResultNoun"] = "request";
    var filters = new[]
    {
        (Key: "all", Label: "All", Count: Model.AllCount),
        (Key: "pending", Label: "Pending", Count: Model.PendingCount),
        (Key: "approved", Label: "Approved", Count: Model.ApprovedCount),
        (Key: "rejected", Label: "Rejected", Count: Model.RejectedCount)
    };
    var emptyLabel = Model.Status == "all" ? "account requests" : $"{Model.Status} account requests";
    var decisionError = ViewBag.DecisionError as string;
    var decisionRequestId = ViewBag.DecisionRequestId as int?;
    var decisionReason = ViewBag.DecisionReason as string;
    var isRejection = ViewBag.IsRejection is true;
    var reopenInDialog = isRejection && decisionRequestId is not null && Model.Items.Any(item => item.RequestId == decisionRequestId);
    var reasonHintId = reopenInDialog ? $"reason-error-{decisionRequestId}" : "reject-reason-hint";
    var query = Context.Request.QueryString.ToString();

    string BadgeClass(string status) => status switch
    {
        "Approved" => "badge badge-approved",
        "Rejected" => "badge badge-rejected",
        _ => "badge badge-pending"
    };
}

<div class="page-heading">
    <h1>Membership Account Requests</h1>
</div>

@if (decisionError != null && !reopenInDialog)
{
    <div class="notice notice-error" role="alert">
        @decisionError <a href="@(Url.Action("Index") + query)">Refresh the queue</a>.
    </div>
    @if (isRejection && !Model.Items.Any(item => item.RequestId == decisionRequestId))
    {
        <div class="field">
            <label for="saved-rejection-reason">Your entered rejection reason (copy it before refreshing)</label>
            <textarea id="saved-rejection-reason" class="field-control" rows="2" readonly>@decisionReason</textarea>
        </div>
    }
}

<partial name="_ListToolbar" model='@(new ListToolbarViewModel("Search name, email, or student number", new ListFilterField[] { ListToolbarViewModel.Course, ListToolbarViewModel.Year }))' />
<div class="sheet-keys">

    <nav class="filter-tabs" aria-label="Request status">
        @foreach (var filter in filters)
        {
            <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = filter.Key })' class="filter-tab"
               aria-current="@(Model.Status == filter.Key ? "page" : null)">
                @filter.Label
                <span class="filter-tab-count">@filter.Count</span>
            </a>
        }
    </nav>
</div>
<p class="muted" data-list-status role="status" data-list-busy-label="Loading records…"></p>

<div class="table-scroll" role="region" aria-label="Account request table" tabindex="0" data-list-region>
    <table class="data-table table-sticky request-table">
        <thead>
            <tr>
                <th scope="col">Full Name</th>
                <th scope="col">Course / year</th>
                <th scope="col">
                    <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["sort"] = Model.NextSort })'
                       aria-label="Sort by requested time, currently @(Model.Sort == "oldest" ? "oldest first" : "newest first")">
                        Requested @(Model.Sort == "oldest" ? "↑" : "↓")
                    </a>
                </th>
                <th scope="col">Status</th>
                <th scope="col" class="actions actions-wide">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="empty-state">No @emptyLabel found.</td>
                </tr>
            }
            else
            {
                foreach (var request in Model.Items)
                {
                    <tr data-request-id="@request.RequestId">
                        <td data-label="Full Name" class="cell-name"><span class="cell-strong">@request.FullName<small class="cell-meta">@request.StudentNumber</small></span></td>
                        <td data-label="Course / year">@request.Course · @request.YearLevel</td>
                        <td data-label="Requested" class="numeric cell-date"><time datetime="@(DateTime.SpecifyKind(request.RequestedAt, DateTimeKind.Utc).ToString("O"))" aria-label="Requested at in Asia/Manila">@ManilaTimeFormatter.Format(request.RequestedAt)</time></td>
                        <td data-label="Status"><span class="@BadgeClass(request.Status)">@request.Status</span></td>
                        <td data-label="Actions" class="actions actions-wide">
                            <div class="row-actions">

                            @if (request.Status == "Pending")
                            {

                                    <button type="button"
                                            class="button button-small button-primary"
                                            data-dialog-open="approve-dialog"
                                            data-dialog-value-id="@request.RequestId"
                                            data-dialog-value-summary="Approve @request.FullName (@request.StudentNumber)?">
                                        Approve
                                    </button>
                                    <button type="button"
                                            class="button button-small button-quiet-danger"
                                            data-dialog-open="reject-dialog"
                                            data-dialog-value-id="@request.RequestId"
                                            data-dialog-value-summary="Decline the request from @request.FullName (@request.StudentNumber)?">
                                        Decline
                                    </button>
                            }
                                <partial name="_DetailsButton" model='@(new RecordDetailsViewModel($"request-details-{request.RequestId}", request.FullName, new Dictionary<string, string> { ["Student number"] = request.StudentNumber, ["Email"] = request.Email, ["Course"] = request.Course, ["Year"] = request.YearLevel.ToString(), ["Section"] = request.Section, ["Mobile"] = request.MobileNumber, ["Requested"] = ManilaTimeFormatter.Format(request.RequestedAt), ["Review notes"] = request.ReviewNotes }, null))' />
                        </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model" />
<partial name="_ResultCount" model="Model" />

<dialog id="reject-dialog"
        class="task-dialog"
        aria-labelledby="reject-dialog-title"
        data-reopen="@(reopenInDialog ? "true" : null)"
        data-reopen-id="@decisionRequestId"
        data-reopen-reason="@decisionReason">
    <form asp-controller="AccountRequest" asp-action="Reject" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" method="post">
        <input type="hidden" name="id" data-dialog-field="id" />
        <div class="dialog-header">
            <h2 id="reject-dialog-title">Decline account request</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">&times;</button>
        </div>
        <p class="muted" data-dialog-field="summary"></p>
        <div class="field">
            <label for="reject-reason">Reason for declining</label>
            <textarea id="reject-reason"
                      name="reason"
                      rows="4"
                      maxlength="500"
                      required
                      placeholder="Explain why the request is declined"
                      class="field-control"
                      aria-describedby="@reasonHintId"
                      aria-invalid="@(reopenInDialog ? "true" : null)"></textarea>
            <span id="reject-reason-hint" class="field-hint">Required. The applicant is not shown this reason.</span>
            @if (reopenInDialog)
            {
                <span id="reason-error-@decisionRequestId" class="field-error" role="alert">@decisionError</span>
            }
        </div>
        <div class="dialog-actions">
            <button type="button" class="button button-secondary" data-dialog-close>Cancel</button>
            <button type="submit" class="button button-danger" data-submitting-label="Declining&hellip;">Decline request</button>
        </div>
    </form>
</dialog>

<dialog id="approve-dialog" class="task-dialog" aria-labelledby="approve-dialog-title">
    <form asp-controller="AccountRequest" asp-action="Approve" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort" method="post">
        <input type="hidden" name="id" data-dialog-field="id" />
        <div class="dialog-header">
            <h2 id="approve-dialog-title">Approve account request</h2>
            <button type="button" class="dialog-close" data-dialog-close aria-label="Close dialog">&times;</button>
        </div>
        <p class="muted" data-dialog-field="summary"></p>
        <p class="dialog-consequence">This creates an active member account and lets the applicant sign in with the password they chose. It cannot be undone from this screen.</p>
        <div class="dialog-actions">
            <button type="button" class="button button-secondary" data-dialog-close>Cancel</button>
            <button type="submit" class="button button-primary" data-submitting-label="Approving&hellip;">Approve request</button>
        </div>
    </form>
</dialog>
