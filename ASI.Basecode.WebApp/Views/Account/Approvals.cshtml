@model IEnumerable<ASI.Basecode.Data.Models.Member>
@{
    ViewData["Title"] = "Membership Approvals";
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold tracking-tight text-ink">Membership Approvals</h1>
                <span class="badge badge--amber">@Model.Count() Pending</span>
            </div>
            <p class="mt-1 text-sm text-ink-secondary">Review and approve student account registration requests.</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Member" asp-action="Index" class="btn btn--secondary btn--sm">
                <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-users"></use></svg>
                <span>Active Member Roster</span>
            </a>
        </div>
    </div>

    <!-- Explanatory note -->
    <div class="card-hairline bg-white border border-slate-200 rounded-lg p-4">
        <div class="flex items-start gap-3">
            <svg class="icon text-lg flex-none text-teal mt-0.5" aria-hidden="true"><use href="/images/icons.svg#i-check-circle"></use></svg>
            <div class="text-xs text-ink-secondary leading-relaxed">
                <span class="font-semibold text-ink block mb-0.5">Automated Member Synchronization (UC-Project-FL #3)</span>
                When an officer approves a pending applicant, their user account is activated immediately for sign-in and their record is enrolled into the official <strong>Members Directory</strong> without manual re-entry.
            </div>
        </div>
    </div>

    <!-- Approvals Ledger Card -->
    <div class="card-elevated bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-ink-muted">
                    <svg class="icon text-xl" aria-hidden="true"><use href="/images/icons.svg#i-check-circle"></use></svg>
                </div>
                <h3 class="mt-4 text-base font-semibold text-ink">All caught up!</h3>
                <p class="mt-1 text-sm text-ink-muted">There are no pending membership requests awaiting review.</p>
                <div class="mt-6">
                    <a asp-controller="Account" asp-action="Register" target="_blank" class="btn btn--secondary btn--sm">
                        <span>Open Registration Form in New Tab</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="table-ledger">
                    <thead>
                        <tr>
                            <th scope="col">Applicant</th>
                            <th scope="col">Student ID</th>
                            <th scope="col">Program &amp; Section</th>
                            <th scope="col">Contact</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var initials = string.Join("", (item.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0]));
                            <tr>
                                <td>
                                    <div class="flex items-center gap-3">
                                        <div class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-indigo-50 font-semibold text-indigo-700 text-xs">
                                            @initials
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-semibold text-ink text-sm">@item.FullName</div>
                                            <div class="text-xs text-ink-muted">Requested membership</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-200">
                                        @item.StudentNumber
                                    </span>
                                </td>
                                <td>
                                    <div class="text-xs font-medium text-ink">@item.CourseYear</div>
                                    <div class="text-[11px] text-ink-muted">Section @item.Section</div>
                                </td>
                                <td>
                                    <span class="text-xs text-ink-secondary">@(item.ContactDetails ?? $"{item.StudentNumber}@ustp.edu.ph")</span>
                                </td>
                                <td>
                                    <span class="badge badge--amber text-xs font-medium">Pending Review</span>
                                </td>
                                <td>
                                    <div class="flex items-center justify-end gap-2">
                                        <form asp-controller="Account" asp-action="Approve" method="post" class="inline">
                                            <input type="hidden" name="studentNumber" value="@item.StudentNumber" />
                                            <button type="submit" class="btn btn--primary btn--sm bg-emerald-600 hover:bg-emerald-700 text-white font-medium">
                                                <svg class="icon text-sm" aria-hidden="true"><use href="/images/icons.svg#i-check"></use></svg>
                                                <span>Approve</span>
                                            </button>
                                        </form>

                                        <form asp-controller="Account" asp-action="Reject" method="post" class="inline" onsubmit="return confirm('Are you sure you want to reject this request?');">
                                            <input type="hidden" name="studentNumber" value="@item.StudentNumber" />
                                            <button type="submit" class="btn btn--ghost btn--sm text-rose-600 hover:bg-rose-50 font-medium">
                                                <svg class="icon text-sm" aria-hidden="true"><use href="/images/icons.svg#i-x"></use></svg>
                                                <span>Reject</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
