@model EventViewModel
@{
    ViewData["Title"] = "Create Draft Event";
}

<h2>Create draft event</h2>
<p class="muted">Drafts are visible to Management only. Publishing arrives in a later story.</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_Form" model="Model" />
    <button type="submit" class="button button-primary">Save draft</button>
    <a asp-action="Index" class="button button-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
