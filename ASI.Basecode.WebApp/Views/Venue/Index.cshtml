@model List<VenueViewModel>
@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Venue Management</h2>
    <a asp-action="Create" class="btn btn-primary">Add Venue</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Room Name</th>
            <th>Capacity</th>
            <th>Location</th>
            <th>Availability Notes</th>
            <th>Contact Person</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venue in Model)
        {
            <tr>
                <td>@venue.RoomName</td>
                <td>@venue.Capacity</td>
                <td>@venue.Location</td>
                <td>@venue.AvailabilityNotes</td>
                <td>@venue.ContactPerson</td>
                <td>@(venue.IsActive ? "Active" : "Inactive")</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@venue.VenueId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@venue.VenueId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm @(venue.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(venue.IsActive ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
