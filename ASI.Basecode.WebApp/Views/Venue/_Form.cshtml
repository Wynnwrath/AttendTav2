@model ASI.Basecode.Services.ServiceModels.VenueViewModel

<div class="card-hairline__body space-y-5 p-6">
    <div asp-validation-summary="ModelOnly" class="text-status-rose text-sm font-medium"></div>

    <input type="hidden" asp-for="VenueId" />

    <div class="field">
        <label asp-for="RoomName" class="field-label field-required">Venue / Room Name</label>
        <input asp-for="RoomName" class="input" placeholder="e.g. Main Auditorium or IT Lab 401" autocomplete="off" required />
        <span asp-validation-for="RoomName" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="Location" class="field-label">Building / Campus Location</label>
        <input asp-for="Location" class="input" placeholder="e.g. College of Engineering, 4th Floor" autocomplete="off" />
        <span asp-validation-for="Location" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="Capacity" class="field-label field-required">Seating Capacity</label>
        <input asp-for="Capacity" type="number" min="0" class="input input--mono" placeholder="e.g. 150" required />
        <p class="text-xs text-ink-muted mt-1">Maximum number of seated participants accommodated.</p>
        <span asp-validation-for="Capacity" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="ContactPerson" class="field-label">Contact Person</label>
        <input asp-for="ContactPerson" class="input" placeholder="e.g. Engr. Santos / Building Administrator" autocomplete="off" />
        <span asp-validation-for="ContactPerson" class="text-xs text-status-rose font-medium"></span>
    </div>

    <div class="field">
        <label asp-for="AvailabilityNotes" class="field-label">Availability / Equipment Notes</label>
        <textarea asp-for="AvailabilityNotes" rows="3" class="input" placeholder="e.g. Sound system and projector available. Requires 2 days advance notice."></textarea>
        <span asp-validation-for="AvailabilityNotes" class="text-xs text-status-rose font-medium"></span>
    </div>
</div>
