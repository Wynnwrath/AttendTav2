@model List<MemberViewModel>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Member Management</h2>
    <span class="text-muted">Member profiles are linked to approved user accounts.</span>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or student number" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student Number</th>
            <th>Full Name</th>
            <th>Course</th>
            <th>Year</th>
            <th>Section</th>
            <th>Mobile</th>
            <th>Membership Type</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.StudentNumber</td>
                <td>@member.FullName</td>
                <td>@member.Course</td>
                <td>@member.YearLevel</td>
                <td>@member.Section</td>
                <td>@member.MobileNumber</td>
                <td>@member.MembershipType</td>
                <td>@member.Status</td>
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleStatus" asp-route-id="@member.MemberId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm @(member.Status == "active" ? "btn-outline-danger" : "btn-outline-success")">@(member.Status == "active" ? "Deactivate" : "Activate")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
