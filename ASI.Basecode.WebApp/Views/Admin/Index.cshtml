@{
    ViewData["Title"] = "Administration Console";
}

<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold tracking-tight text-ink">System Administration &amp; Governance</h1>
                <span class="badge badge--rose">Admin Console</span>
            </div>
            <p class="mt-1 text-sm text-ink-secondary">Manage officer roles, permission matrix levels, and review security audit logs.</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Member" asp-action="Index" class="btn btn--primary btn--sm">
                <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-users"></use></svg>
                <span>Go to Master Data (Members)</span>
            </a>
        </div>
    </div>

    <!-- Explanatory Showcase Card -->
    <div class="card-elevated bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-950 text-white rounded-2xl p-8 shadow-md border border-slate-700 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl">
            <span class="badge bg-amber-500/20 text-amber-300 border border-amber-400/30 text-xs font-medium uppercase tracking-wider mb-3">
                System Administration Milestone
            </span>
            <h2 class="text-2xl font-extrabold tracking-tight mt-1 text-white">
                Officer &amp; Permission Management
            </h2>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">
                You are authenticated as the <strong>System Administrator</strong> (<code>admin</code>).
            </p>
            <div class="mt-4 p-4 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-200 space-y-1.5">
                <div class="font-semibold text-white text-sm flex items-center gap-2">
                    <span class="inline-block h-2 w-2 rounded-full bg-amber-400"></span>
                    Under Development (Assigned to Member 5)
                </div>
                <p class="text-slate-300">
                    The administration and security module is part of the <strong>Administration</strong> scope from <code>UC-Project-FL.pdf</code>. Planned features in progress:
                </p>
                <ul class="list-disc list-inside space-y-1 text-slate-300 pt-1">
                    <li><strong>Officer &amp; Role Matrix Management</strong>: Assign authority presets (Admin, Officer, Staff, Member)</li>
                    <li><strong>Granular Operational Permissions</strong>: 10 individual capability scopes (Event publishing, check-in, certificates, etc.)</li>
                    <li><strong>Account Deactivation &amp; Lockout</strong>: Immediate suspension of compromised or inactive credentials</li>
                    <li><strong>Security Audit Trails</strong>: Detailed event logs tracking timestamps, actors, categories, and actions</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Links to Master Data Modules -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card-hairline bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="h-10 w-10 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center mb-3">
                    <svg class="icon text-xl" aria-hidden="true"><use href="/images/icons.svg#i-users"></use></svg>
                </div>
                <h3 class="font-bold text-base text-ink">Organization Members</h3>
                <p class="mt-1 text-xs text-ink-muted">Master roster of all active and inactive registered students.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
                <a asp-controller="Member" asp-action="Index" class="btn btn--secondary btn--sm w-full">
                    <span>Manage Members</span>
                </a>
            </div>
        </div>

        <div class="card-hairline bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="h-10 w-10 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center mb-3">
                    <svg class="icon text-xl" aria-hidden="true"><use href="/images/icons.svg#i-map-pin"></use></svg>
                </div>
                <h3 class="font-bold text-base text-ink">Campus Venues</h3>
                <p class="mt-1 text-xs text-ink-muted">Room facilities, seating capacities, and equipment notes.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
                <a asp-controller="Venue" asp-action="Index" class="btn btn--secondary btn--sm w-full">
                    <span>Manage Venues</span>
                </a>
            </div>
        </div>

        <div class="card-hairline bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
            <div>
                <div class="h-10 w-10 rounded-lg bg-amber-50 text-amber-700 flex items-center justify-center mb-3">
                    <svg class="icon text-xl" aria-hidden="true"><use href="/images/icons.svg#i-list"></use></svg>
                </div>
                <h3 class="font-bold text-base text-ink">Event Classifications</h3>
                <p class="mt-1 text-xs text-ink-muted">Seminars, workshops, and recognition ceremony categories.</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
                <a asp-controller="EventType" asp-action="Index" class="btn btn--secondary btn--sm w-full">
                    <span>Manage Event Types</span>
                </a>
            </div>
        </div>
    </div>
</div>
