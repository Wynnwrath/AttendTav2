@{
    ViewData["Title"] = "Student Portal";
    Layout = null;
    var userName = User.Identity?.Name ?? "Student Member";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal &middot; AttendTa</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="~/js/tailwind.config.js" asp-append-version="true"></script>
</head>
<body class="min-h-[100dvh] flex flex-col bg-canvas-ground font-sans text-ink antialiased">
    <!-- Top Nav -->
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                    <img src="~/images/attendTa_logo.jpg" alt="AttendTa logo" width="32" height="32" class="h-8 w-8 rounded object-contain">
                    <span class="font-extrabold text-base tracking-tight text-ink">AttendTa</span>
                    <span class="badge badge--mono badge--neutral hidden sm:inline-flex">Student Portal</span>
                </a>
            </div>

            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <div class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-indigo-100 font-semibold text-indigo-700 text-xs">
                        ST
                    </div>
                    <div class="hidden sm:block text-right">
                        <div class="text-xs font-semibold text-ink">@userName</div>
                        <div class="font-mono text-[11px] text-ink-muted">Student Account</div>
                    </div>
                </div>
                <a asp-controller="Account" asp-action="SignOutUser" class="btn btn--ghost btn--sm text-rose-600 hover:bg-rose-50" aria-label="Sign out">
                    <svg class="icon text-base" aria-hidden="true"><use href="/images/icons.svg#i-log-out"></use></svg>
                    <span class="hidden sm:inline">Sign Out</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 py-10 px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Showcase Status Banner -->
            <div class="card-elevated bg-gradient-to-br from-indigo-900 via-slate-900 to-indigo-950 text-white rounded-2xl p-8 shadow-md border border-indigo-800/40 relative overflow-hidden">
                <div class="relative z-10 max-w-2xl">
                    <span class="badge bg-indigo-500/20 text-indigo-200 border border-indigo-400/30 text-xs font-medium uppercase tracking-wider mb-3">
                        Transactions Module Milestone
                    </span>
                    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight mt-1">
                        Student Portal &amp; Event Passes
                    </h1>
                    <p class="mt-3 text-sm text-slate-300 leading-relaxed">
                        Welcome to AttendTa! You are authenticated with your active student credentials.
                    </p>
                    <div class="mt-4 p-4 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-200 space-y-1.5">
                        <div class="font-semibold text-white text-sm flex items-center gap-2">
                            <span class="inline-block h-2 w-2 rounded-full bg-amber-400"></span>
                            Under Development (Assigned to Members 3 &amp; 4)
                        </div>
                        <p class="text-slate-300">
                            The student experience is part of the <strong>Transactions</strong> module from <code>UC-Project-FL.pdf</code>. Upcoming features in progress:
                        </p>
                        <ul class="list-disc list-inside space-y-1 text-slate-300 pt-1">
                            <li><strong>Online Event Registration</strong> with real-time seat availability quotas (Member 3)</li>
                            <li><strong>Digital Door Pass Generator</strong> with unique QR code credential badges (Member 3)</li>
                            <li><strong>Attendance Check-In Kiosk</strong> integration and verified participant timestamps (Member 4)</li>
                            <li><strong>Personal Attendance Vault</strong> with downloadable completion certificates (Member 4)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Preview Event Showcase Cards -->
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold text-ink">Upcoming Campus Events Preview</h2>
                    <span class="text-xs text-ink-muted">Preview Showcase</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Event 1 -->
                    <div class="card-hairline bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="badge badge--indigo">Seminar</span>
                                <span class="font-mono text-xs text-ink-muted">Oct 28, 2026</span>
                            </div>
                            <h3 class="font-bold text-base text-ink">Annual Tech Summit &amp; Innovation Expo</h3>
                            <p class="mt-1 text-xs text-ink-secondary">Main Auditorium &bull; 150 Seats Capacity</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-xs font-semibold text-emerald-600">Registration Open</span>
                            <button type="button" disabled class="btn btn--secondary btn--sm opacity-60 cursor-not-allowed">
                                <span>Register (Member 3)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Event 2 -->
                    <div class="card-hairline bg-white rounded-xl p-5 border border-slate-200 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span class="badge badge--teal">Workshop</span>
                                <span class="font-mono text-xs text-ink-muted">Nov 04, 2026</span>
                            </div>
                            <h3 class="font-bold text-base text-ink">Cloud Architecture Hands-On Lab</h3>
                            <p class="mt-1 text-xs text-ink-secondary">IT Multimedia Lab 401 &bull; 60 Seats Capacity</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-xs font-semibold text-emerald-600">Registration Open</span>
                            <button type="button" disabled class="btn btn--secondary btn--sm opacity-60 cursor-not-allowed">
                                <span>Register (Member 3)</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center pt-4">
                <a asp-controller="Account" asp-action="SignOutUser" class="btn btn--secondary btn--sm">
                    <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-log-out"></use></svg>
                    <span>Sign Out &amp; Return to Login</span>
                </a>
            </div>
        </div>
    </main>

    <footer class="py-4 text-center text-xs text-ink-muted border-t border-slate-200 bg-white">
        &copy; @DateTime.Now.Year USTP Student Organization Council &mdash; AttendTa
    </footer>
</body>
</html>
