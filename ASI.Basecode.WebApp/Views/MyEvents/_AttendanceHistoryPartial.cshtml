@model MyEventsAttendanceTabViewModel
@if (Model.Rows.Count > 0)
{
    <div class="table-scroll attendance-history" role="region" aria-label="Attendance history" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Recorded</th>
                    <th scope="col">Method</th>
                    <th scope="col">State</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-attendance-id="@row.AttendanceId">
                        <td data-label="Event">@row.EventTitle</td>
                        <td data-label="Recorded" class="numeric">@ManilaTimeFormatter.Format(row.RecordedAt)</td>
                        <td data-label="Method">@row.CheckInMethodLabel</td>
                        <td data-label="State">
                            @if (row.IsInvalidated)
                            {
                                <span class="badge badge-inactive">Invalidated</span>
                                @if (!string.IsNullOrWhiteSpace(row.InvalidationReason))
                                {
                                    <span class="muted">@row.InvalidationReason</span>
                                }
                            }
                            else
                            {
                                <span class="badge badge-active">Valid</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
