@model PagedResult<AccountSummaryViewModel>
@{
    ViewData["ListControls"] = true;
    ViewData["Feature"] = "record-dialog";
    ViewData["Title"] = "Accounts & Roles";
    var search = ViewBag.Search as string;
}

<div class="page-heading">
    <h1>Accounts &amp; Roles</h1>
</div>

<partial name="_ListToolbar" model='@(new ListToolbarViewModel("Search name or email", new ListFilterField[] { ListToolbarViewModel.Status(new ListFilterOption("active", "Active"), new ListFilterOption("inactive", "Inactive")), new ListFilterField("role", "Role", Options: new[] { new ListFilterOption("admin", "Administrator"), new ListFilterOption("officer", "Officer"), new ListFilterOption("member", "Member") }) }))' />
<p class="muted" data-list-status role="status" data-list-busy-label="Loading records…"></p>
<div class="table-scroll" role="region" aria-label="Accounts table" tabindex="0" data-list-region>
    <table class="data-table table-sticky-first">
        <thead>
            <tr>
                <th scope="col">Full Name</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Status</th>
                <th scope="col" class="actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="empty-state">@(string.IsNullOrWhiteSpace(search) ? "No accounts found." : "No accounts match your search.")</td>
                </tr>
            }
            else
            {
                foreach (var account in Model.Items)
                {
                    <tr data-account-id="@account.AccountId">
                        <td data-label="Full Name" class="cell-name"><span class="cell-strong">@account.FullName</span></td>
                        <td data-label="Email" class="cell-email">@account.Email</td>
                        <td data-label="Role"><span class="badge badge-@account.RoleCode">@account.RoleLabel</span></td>
                        <td data-label="Status"><span class="badge @(account.IsActive ? "badge-active" : "badge-inactive")">@(account.IsActive ? "Active" : "Inactive")</span></td>
                        <td data-label="Actions" class="actions">
                            <div class="row-actions">
                                <a asp-action="ChangeRole" asp-route-id="@account.AccountId" class="button button-secondary" data-record-open="change-role-@account.AccountId" data-record-title="Change role">Change role</a>
                                <partial name="_RowMenuTrigger" model="@($"row-menu-account-{account.AccountId}")" />
                            </div>
                            <div id="row-menu-account-@account.AccountId" popover class="row-menu">
                                <div class="row-menu-danger">
                                    <partial name="_AccessActions" model="AccountAccessViewModel.For(account)" />
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model" />
<partial name="_ResultCount" model="Model" />
<partial name="_RecordDialog" />
