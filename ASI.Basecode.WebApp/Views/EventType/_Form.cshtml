@model EventTypeViewModel

<div class="field">
    <label asp-for="TypeName" class="field-label">Type name</label>
    <input asp-for="TypeName" aria-describedby="TypeName-validation" class="field-control" />
    <span id="TypeName-validation" asp-validation-for="TypeName" class="field-error"></span>
</div>
<div class="field">
    <label asp-for="Description" class="field-label"></label>
    <textarea asp-for="Description" aria-describedby="Description-validation" class="field-control" rows="3"></textarea>
    <span id="Description-validation" asp-validation-for="Description" class="field-error"></span>
</div>
