@model IPagedResult
@using System
@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions
@{
    var autoFit = ViewData["ListControls"] as bool? == true && ViewData["AutoFit"] as bool? != false;
    var pagingMode = autoFit ? ViewData["PagingMode"] as string ?? "auto" : "fixed";
    string PageUrl(int pageNumber)
    {
        var query = new QueryBuilder();
        foreach (var parameter in Context.Request.Query)
        {
            if (ListReadOptionsFactory.IsRetiredFilter(Context.Request, parameter.Key) || !autoFit && parameter.Key is "pageSize" or "fit") continue;
            if (string.Equals(parameter.Key, "page", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            foreach (var value in parameter.Value)
            {
                query.Add(parameter.Key, value);
            }
        }

        query.Add("page", pageNumber.ToString(CultureInfo.InvariantCulture));
        var path = ViewData["PagerPath"] as string ?? $"{Context.Request.PathBase}{Context.Request.Path}";
        return $"{path}{query.ToQueryString()}";
    }
}

@if (Model.TotalCount > 0)
{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var noun = ListPagingLabels.Noun(controller, ViewContext.RouteData.Values["action"]?.ToString(), Model.TotalCount, ViewData["ResultNoun"] as string);
    var filtered = ListPagingLabels.IsFiltered(Context.Request);
    <nav class="pager" aria-label="Pagination" data-paging-size="@Model.PageSize" data-paging-page="@Model.PageNumber" data-paging-mode="@pagingMode" data-paging-total="@Model.TotalCount">
        <p class="pagination-summary" aria-live="polite">Showing @Model.FirstItemNumber–@Model.LastItemNumber of @Model.TotalCount @(filtered ? "matching " : "")@noun</p>
        <span class="paging-mode muted">@(autoFit ? "Auto · " : "")@Model.PageSize per page</span>
        <div class="pager-actions">
            @if (Model.HasPreviousPage)
            {
                <a class="button button-secondary" rel="prev" href="@PageUrl(Model.PageNumber - 1)" aria-label="Previous page">Previous</a>
            }
            else { <button type="button" class="button button-secondary" disabled>Previous</button> }
            <span class="numeric">Page @Model.PageNumber of @Model.TotalPages</span>
            @if (Model.HasNextPage)
            {
                <a class="button button-secondary" rel="next" href="@PageUrl(Model.PageNumber + 1)" aria-label="Next page">Next</a>
            }
            else { <button type="button" class="button button-secondary" disabled>Next</button> }
        </div>
    </nav>
}
