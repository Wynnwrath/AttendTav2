@model PagedResult<MemberViewModel>
@using Microsoft.AspNetCore.Http.Extensions
@{
    ViewData["ListControls"] = true;
    ViewData["Title"] = "Organization Members";
    ViewData["Feature"] = "record-dialog";
    var statusFilter = ViewBag.Status as string;
    var searchTerm = ViewBag.Search as string;
    var listError = ViewData["ListError"] as string;

}

<div class="page-heading">
    <h1>Organization Members</h1>
</div>

<partial name="_ListToolbar" model='@(new ListToolbarViewModel("Search name, email, or student number", new ListFilterField[] { ListToolbarViewModel.Course, ListToolbarViewModel.Year }))' />
<div class="sheet-keys">

    <nav class="filter-tabs" aria-label="Membership status">
        <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = null })' class="filter-tab" aria-current="@(string.IsNullOrEmpty(statusFilter) ? "page" : null)">All</a>
        <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = "active" })' class="filter-tab" aria-current="@(statusFilter == "active" ? "page" : null)">Active</a>
        <a href='@ListNavigation.Url(Context.Request, new Dictionary<string, string> { ["status"] = "inactive" })' class="filter-tab" aria-current="@(statusFilter == "inactive" ? "page" : null)">Inactive</a>
    </nav>
</div>

<p class="muted" data-list-status role="status" data-list-busy-label="Loading members…"></p>

@if (!string.IsNullOrEmpty(listError))
{
    <div class="notice notice-error" role="alert">
        <p>@listError</p>
        <a href="@Context.Request.GetEncodedPathAndQuery()">Try again</a>
    </div>
    <div class="table-scroll" role="region" aria-label="Member table" tabindex="0" data-list-region>
        <table class="data-table roster-table table-sticky">
            <thead>
                <tr>
                    <th scope="col">Full Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Course / year / section</th>
                    <th scope="col" class="column-status">Status</th>
                    <th scope="col" class="actions actions-tight">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="table-scroll" role="region" aria-label="Member table" tabindex="0" data-list-region>
        <table class="data-table roster-table table-sticky">
            <thead>
                <tr>
                    <th scope="col">Full Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Course / year / section</th>
                    <th scope="col" class="column-status">Status</th>
                    <th scope="col" class="actions actions-tight">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" class="empty-state">
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <text>No members match your search. Try a different name or student number.</text>
                        }
                        else if (!string.IsNullOrEmpty(statusFilter))
                        {
                            <text>No @statusFilter members.</text>
                        }
                        else
                        {
                            <text>No members yet. Members are created when an account request is approved.</text>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-scroll" role="region" aria-label="Member table" tabindex="0" data-list-region>
        <table class="data-table roster-table table-sticky">
            <thead>
                <tr>
                    <th scope="col">Full Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Course / year / section</th>
                    <th scope="col" class="column-status">Status</th>
                    <th scope="col" class="actions actions-tight">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model.Items)
                {

                    var displayName = member.FullName ?? string.Empty;
                    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));
                    var details = new RecordDetailsViewModel($"member-details-{member.MemberId}", member.FullName, new Dictionary<string, string> { ["Student number"] = member.StudentNumber, ["Mobile"] = member.MobileNumber, ["Membership type"] = member.MembershipType }, null);
                    <tr data-member-id="@member.MemberId">
                        <td data-label="Full Name">
                            <span class="name-cell">
                                <span class="name-initials" aria-hidden="true">@initials</span>
                                <span class="name-text">@member.FullName<small class="cell-meta">@member.StudentNumber</small></span>
                            </span>
                        </td>
                        <td data-label="Email" class="cell-email">@member.Email</td>
                        <td data-label="Course / year / section">@member.Course · @member.YearLevel · @(string.IsNullOrWhiteSpace(member.Section) ? "Not provided" : member.Section)</td>
                        <td data-label="Status"><span class="badge @(member.Status == "active" ? "badge-active" : "badge-inactive")">@(member.Status == "active" ? "Active" : "Inactive")</span></td>
                        <td data-label="Actions" class="actions">
                            <div class="row-actions">

                                <a asp-action="Edit" asp-route-id="@member.MemberId" class="button button-small button-secondary" data-record-open="edit-member-@member.MemberId" data-record-title="Edit Member" data-record-subtitle="@member.FullName · @member.StudentNumber">Edit</a>
                                <partial name="_RowMenuTrigger" model="@($"row-menu-member-{member.MemberId}")" />
                            </div>
                            <div id="row-menu-member-@member.MemberId" popover class="row-menu">
                                <partial name="_DetailsTrigger" model="details" />
                                <div class="row-menu-danger">
                                    <partial name="_AccessActions" model="MembershipAccessViewModel.For(member)" />
                                </div>
                            </div>
                        <partial name="_DetailsDialog" model="details" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model" />
}

<partial name="_ResultCount" model="Model" />
<partial name="_RecordDialog" />
