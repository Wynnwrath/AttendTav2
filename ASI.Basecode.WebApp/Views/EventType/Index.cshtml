@model PagedResult<EventTypeViewModel>
@{
    ViewData["Title"] = "Event Types";
}

<div class="page-heading">
    <h2>Event Type Management</h2>
    <a asp-action="Create" class="button button-primary">Add Event Type</a>
</div>

@if (Model.Items.Count == 0)
{
    <p class="empty-state">No records found.</p>
}
else
{
    <div class="table-scroll" role="region" aria-label="EventType table" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Type Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eventType in Model.Items)
                {
                    <tr data-type-id="@eventType.TypeId">
                        <td>@eventType.TypeName</td>
                        <td>@eventType.Description</td>
                        <td>@(eventType.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@eventType.TypeId" class="button button-secondary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@eventType.TypeId" method="post" class="inline-form">
                                <button type="submit" class="button button-secondary">@(eventType.IsActive ? "Deactivate" : "Activate")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model" />
}
