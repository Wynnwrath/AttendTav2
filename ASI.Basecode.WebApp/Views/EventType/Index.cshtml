@model List<ASI.Basecode.Services.ServiceModels.EventTypeViewModel>
@{
    ViewData["Title"] = "Event Types";

    Func<string, (string colorVar, string subtleVar, string deepVar, string label)> getAccent = (typeName) =>
    {
        var name = (typeName ?? "").ToLowerInvariant();
        if (name.Contains("seminar")) return ("var(--event-indigo)", "var(--event-indigo-subtle)", "var(--event-indigo-deep)", "Indigo");
        if (name.Contains("recognition") || name.Contains("ceremony")) return ("var(--event-amber)", "var(--event-amber-subtle)", "var(--event-amber-deep)", "Amber");
        if (name.Contains("workshop") || name.Contains("training")) return ("var(--event-teal)", "var(--event-teal-subtle)", "var(--event-teal-deep)", "Teal");
        if (name.Contains("assembly") || name.Contains("meeting")) return ("var(--event-slate)", "var(--event-slate-subtle)", "var(--event-slate-deep)", "Slate");
        if (name.Contains("outreach")) return ("var(--event-moss)", "var(--event-moss-subtle)", "var(--event-moss-deep)", "Moss");
        if (name.Contains("sport")) return ("var(--event-orange)", "var(--event-orange-subtle)", "var(--event-orange-deep)", "Orange");
        if (name.Contains("culture") || name.Contains("cultural")) return ("var(--event-violet)", "var(--event-violet-subtle)", "var(--event-violet-deep)", "Violet");
        return ("var(--event-indigo)", "var(--event-indigo-subtle)", "var(--event-indigo-deep)", "Indigo");
    };
}

<div class="mx-auto w-full max-w-6xl space-y-6">
    <!-- Page header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="min-w-0">
            <h1 class="font-gate text-2xl font-bold tracking-tight text-ink">Event Types</h1>
            <p class="mt-1 max-w-2xl text-sm text-ink-muted">Classification tags, visual accent families, and descriptions.</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <a asp-action="Create" class="btn btn--primary btn--sm inline-flex items-center gap-1.5">
                <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-plus"></use></svg>
                <span>Add Event Type</span>
            </a>
        </div>
    </div>

    <!-- Event Types table -->
    <section class="card-hairline" aria-label="Event types directory">
        <div class="table-scroll">
            <table class="table-ledger table-ledger--cards" data-table>
                <thead>
                    <tr>
                        <th scope="col" data-sort="name">Type</th>
                        <th scope="col">Accent Family</th>
                        <th scope="col">Description</th>
                        <th scope="col" class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-8 text-ink-muted">
                                No event types defined yet. Click "Add Event Type" to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var eventType in Model)
                        {
                            var accent = getAccent(eventType.TypeName);
                            <tr>
                                <td data-th="Type">
                                    <div class="flex items-center gap-2.5">
                                        <span class="h-2.5 w-2.5 flex-none rounded-pill"
                                              style="background: @accent.colorVar" aria-hidden="true"></span>
                                        <span class="font-semibold text-ink">@eventType.TypeName</span>
                                    </div>
                                </td>
                                <td data-th="Accent">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs text-ink-muted">@accent.label.ToLower()</span>
                                        <span class="inline-flex items-center rounded-pill px-2 py-0.5 text-xs font-semibold"
                                              style="background: @accent.subtleVar; color: @accent.deepVar">@accent.label</span>
                                    </div>
                                </td>
                                <td data-th="Description">
                                    <span class="text-sm text-ink-secondary">@(string.IsNullOrEmpty(eventType.Description) ? "—" : eventType.Description)</span>
                                </td>
                                <td data-th="Actions" class="text-right">
                                    <div class="inline-flex items-center gap-1.5 justify-end">
                                        <a asp-action="Edit" asp-route-id="@eventType.TypeId" class="btn btn--secondary btn--sm">
                                            Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
