@model EventTypeViewModel
@{
    ViewData["Title"] = "Add Event Type";
}

<h2>Add Event Type</h2>


<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_Form" model="Model" />
    <button type="submit" class="button button-primary">Save</button>
    <a asp-action="Index" class="button button-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
